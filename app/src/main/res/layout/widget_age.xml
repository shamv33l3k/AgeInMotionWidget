<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/widget_root"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:gravity="center_vertical"
    android:padding="14dp"
    android:background="@drawable/widget_background">

    <TextView
        android:id="@+id/widget_title"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="A G E  I N  M O T I O N"
        android:fontFamily="monospace"
        android:textSize="9sp"
        android:singleLine="true"
        android:ellipsize="end"
        android:textColor="#BDBDBD" />

    <ImageView
        android:id="@+id/dot_age"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:scaleType="fitCenter"
        android:adjustViewBounds="false"
        android:contentDescription="Age in years" />

    <TextView
        android:id="@+id/widget_caption"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:fontFamily="monospace"
        android:text="YEARS / ALWAYS MOVING"
        android:textColor="#9B9B9B"
        android:textSize="8sp"
        android:singleLine="true" />

    <Chronometer
        android:id="@+id/live_timer"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:fontFamily="monospace"
        android:textSize="11sp"
        android:textColor="#FFFFFF"
        android:layout_marginTop="4dp"
        android:format="TODAY  %s" />
</LinearLayout>
