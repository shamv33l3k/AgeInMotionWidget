<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/widget_root"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:padding="13dp"
    android:gravity="center_vertical"
    android:background="@drawable/widget_background">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:gravity="center_vertical">
        <TextView
            android:id="@+id/widget_title"
            android:layout_width="0dp"
            android:layout_weight="1"
            android:layout_height="wrap_content"
            android:text="A G E   I N   M O T I O N"
            android:textColor="#DDDDDD"
            android:textSize="9sp"
            android:fontFamily="monospace"
            android:singleLine="true" />
        <TextView
            android:id="@+id/widget_state"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="ECO"
            android:textColor="#AAAAAA"
            android:textSize="9sp"
            android:fontFamily="monospace" />
    </LinearLayout>

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:minHeight="56dp"
        android:orientation="horizontal"
        android:gravity="center_vertical">
        <ImageView
            android:id="@+id/dot_years"
            android:layout_width="0dp"
            android:layout_weight="3"
            android:layout_height="match_parent"
            android:scaleType="fitCenter"
            android:contentDescription="Completed years" />
        <ImageView
            android:id="@+id/dot_fraction"
            android:layout_width="0dp"
            android:layout_weight="7"
            android:layout_height="match_parent"
            android:scaleType="fitCenter"
            android:contentDescription="Fraction of current year" />
    </LinearLayout>

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal">
        <TextView
            android:layout_width="0dp"
            android:layout_weight="3"
            android:layout_height="wrap_content"
            android:id="@+id/widget_years_label"
            android:text="FULL YEARS"
            android:gravity="center"
            android:textColor="#AAAAAA"
            android:fontFamily="monospace"
            android:textSize="8sp" />
        <TextView
            android:layout_width="0dp"
            android:layout_weight="7"
            android:layout_height="wrap_content"
            android:id="@+id/widget_fraction_label"
            android:text="FRACTION OF A YEAR"
            android:gravity="center"
            android:textColor="#AAAAAA"
            android:fontFamily="monospace"
            android:textSize="8sp" />
    </LinearLayout>

    <ProgressBar
        android:id="@+id/year_progress"
        style="?android:attr/progressBarStyleHorizontal"
        android:layout_width="match_parent"
        android:layout_height="3dp"
        android:layout_marginTop="8dp"
        android:max="1000"
        android:progress="0"
        android:progressTint="#FFFFFF"
        android:progressBackgroundTint="#333333" />

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="7dp"
        android:orientation="horizontal"
        android:gravity="center_vertical">
        <TextView
            android:id="@+id/widget_caption"
            android:layout_width="0dp"
            android:layout_weight="1"
            android:layout_height="wrap_content"
            android:fontFamily="monospace"
            android:text="SET YOUR BIRTHDAY"
            android:textColor="#EEEEEE"
            android:textSize="9sp"
            android:maxLines="1"
            android:ellipsize="end" />
        <TextView
            android:id="@+id/widget_refresh"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="↻"
            android:textColor="#BBBBBB"
            android:contentDescription="Refresh age"
            android:paddingLeft="8dp"
            android:paddingRight="4dp"
            android:textSize="16sp" />
    </LinearLayout>
</LinearLayout>
